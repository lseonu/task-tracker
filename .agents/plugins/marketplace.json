{
  "name": "devpost-hackathon-prototypes",
  "interface": {
    "displayName": "Devpost Hackathon Prototypes",
    "description": "Early Devpost hackathon plugin prototypes for Codex Desktop and Codex CLI."
  },
  "plugins": [
    {
      "name": "devpost-hackathon-desktop",
      "source": {
        "source": "local",
        "path": "./plugins/devpost-hackathon-desktop"
      },
      "category": "Developer Tools",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "devpost-hackathon-cli",
      "source": {
        "source": "local",
        "path": "./plugins/devpost-hackathon-cli"
      },
      "category": "Developer Tools",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    }
  ]
}
